<configuration>

  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%-10X{transaction_id}] %-5level %logger - %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="sonia.scm" level="WARN" />
  <logger name="com.cloudogu" level="WARN" />

  <logger name="sonia.scm.search" level="TRACE" />
  <logger name="com.cloudogu.scm.search" level="TRACE" />

  <root level="WARN">
    <appender-ref ref="STDOUT" />
  </root>

</configuration>
